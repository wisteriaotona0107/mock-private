{
  "name": "master-maint-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:fe\"",
    "dev:api": "npm --prefix mock-api run dev",
    "dev:fe": "npx http-server ./frontend -p 3000 -c-1",
    "postinstall": "npm --prefix mock-api install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1"
  }
}
