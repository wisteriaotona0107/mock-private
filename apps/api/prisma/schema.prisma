datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Gender {
  male
  female
  other
  undisclosed
}

enum AgeRange {
  teens
  twenties
  thirties
  forties
  fifties_plus
}

enum UserRole {
  user
  admin
}

enum ContentStatus {
  draft
  reviewing
  published
  archived
}

enum QuestionType {
  single
  multiple
  scale
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  gender       Gender?
  ageRange     AgeRange?
  scalpType    String?
  role         UserRole  @default(user)
  anonymizedId String    @unique @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  diagnoses    Diagnosis[]
  routines     Routine[]
  contents     Content[] @relation("ContentAuthor")
  favorites    Favorite[]
  reviews      Review[]
  compareList  CompareList?
  enrollments  Enrollment[]
  auditLogs    AuditLog[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  plan      String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Content {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  body        String
  summary     String?
  status      ContentStatus  @default(draft)
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tags        ContentTag[]
  auditLogs   AuditLog[]

  author User @relation("ContentAuthor", fields: [authorId], references: [id])
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  content   ContentTag[]
  products  ProductTag[]
}

model ContentTag {
  contentId String
  tagId     String

  content Content @relation(fields: [contentId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([contentId, tagId])
}

model Product {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  category          String
  price             Decimal       @db.Decimal(10, 2)
  currency          String        @default("JPY")
  description       String?
  evidenceLevel     Int           @default(1)
  ingredientSafety  Int           @default(50)
  reviewScore       Float         @default(0)
  reviewCount       Int           @default(0)
  costPerformance   Int           @default(50)
  ingredients       Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tags              ProductTag[]
  favorites         Favorite[]
  reviews           Review[]
  recommendations   RecommendationLog[]
  compareItems      CompareItem[]
  /// @@db.Check("ingredient_safety BETWEEN 0 AND 100")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model RuleSet {
  id          String    @id @default(uuid())
  version     String    @unique
  title       String
  description String?
  config      Json
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  diagnoses   Diagnosis[]
}

model DiagnosisQuestion {
  id        String       @id @default(uuid())
  code      String       @unique
  text      String
  type      QuestionType
  order     Int
  options   Json
  weight    Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Diagnosis {
  id             String             @id @default(uuid())
  userId         String?
  ruleSetId      String
  scores         Json
  labels         Json
  season         String
  profile        Json
  medicalReferral Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  answers        DiagnosisAnswer[]
  recommendations RecommendationLog[]

  user    User?    @relation(fields: [userId], references: [id])
  ruleSet RuleSet  @relation(fields: [ruleSetId], references: [id])
}

model DiagnosisAnswer {
  id           String    @id @default(uuid())
  diagnosisId  String
  questionCode String
  value        Json

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id])

  @@index([diagnosisId])
}

model RecommendationLog {
  id           String    @id @default(uuid())
  diagnosisId  String?
  productId    String
  rank         Int
  score        Float
  reason       String
  createdAt    DateTime @default(now())

  diagnosis Diagnosis? @relation(fields: [diagnosisId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
}

model Routine {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String?
  frequency   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       RoutineItem[]
  checkins    RoutineCheckin[]

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RoutineItem {
  id        String   @id @default(uuid())
  routineId String
  name      String
  schedule  String
  order     Int      @default(0)

  routine Routine @relation(fields: [routineId], references: [id])

  @@index([routineId])
}

model RoutineCheckin {
  id        String   @id @default(uuid())
  routineId String
  date      DateTime
  completed Boolean  @default(true)

  routine Routine @relation(fields: [routineId], references: [id])

  @@unique([routineId, date])
}

model CompareList {
  id        String        @id @default(uuid())
  userId    String        @unique
  items     CompareItem[]

  user User @relation(fields: [userId], references: [id])
}

model CompareItem {
  id            String   @id @default(uuid())
  compareListId String
  productId     String
  order         Int      @default(0)

  compareList CompareList @relation(fields: [compareListId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([compareListId, productId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
}
